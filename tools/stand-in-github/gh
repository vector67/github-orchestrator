#!/usr/bin/env python3
import json
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ORIGIN = HERE / "widgets.git"
ACCOUNT = "octocat"
REPO = "acme/widgets"
NUMBER = 1
BRANCH = "add-widget"
TOKEN = re.compile(r'\.\.\.|[A-Za-z_$][A-Za-z0-9_]*|"(?:[^"\\]|\\.)*"|[{}():\[\],!=@]|-?\d+(?:\.\d+)?')
LISTS = {"nodes", "edges", "contexts"}


def head_sha():
    return subprocess.run(["git", "-C", str(ORIGIN), "rev-parse", BRANCH],
                          capture_output=True, text=True, check=True).stdout.strip()


def leaf(name):
    return {
        "number": NUMBER, "databaseId": 1, "id": "PR_stand_in", "title": "add a widget",
        "url": f"https://github.com/{REPO}/pull/{NUMBER}", "body": "", "isDraft": False,
        "createdAt": "2026-11-01T00:00:00Z", "updatedAt": "2026-11-01T00:00:00Z",
        "headRefName": BRANCH, "baseRefName": "main", "headRefOid": head_sha(),
        "changedFiles": 1, "additions": 1, "deletions": 0, "mergeable": "MERGEABLE",
        "mergeStateStatus": "CLEAN", "state": "OPEN", "login": ACCOUNT, "__typename": "User",
        "totalCount": 1, "viewerDidAuthor": True, "hasNextPage": False, "nameWithOwner": REPO,
        "name": REPO.split("/")[1], "closed": False, "merged": False,
    }.get(name)


def past_parentheses(tokens, at):
    depth = 0
    while True:
        depth += {"(": 1, ")": -1}.get(tokens[at], 0)
        at += 1
        if depth == 0:
            return at


def selection(tokens, at):
    fields = []
    at += 1
    while tokens[at] != "}":
        if tokens[at] == "...":
            at += 3 if tokens[at + 1] == "on" else 1
            spread, at = selection(tokens, at)
            fields.extend(spread)
            continue
        alias = name = tokens[at]
        at += 1
        if tokens[at] == ":":
            name = tokens[at + 1]
            at += 2
        if tokens[at] == "(":
            at = past_parentheses(tokens, at)
        while tokens[at] == "@":
            at += 2
            if tokens[at] == "(":
                at = past_parentheses(tokens, at)
        children = None
        if tokens[at] == "{":
            children, at = selection(tokens, at)
        fields.append((alias, name, children))
    return fields, at + 1


def answer(fields):
    return {alias: leaf(name) if children is None else [] if name in LISTS else answer(children)
            for alias, name, children in fields}


def graphql(args):
    query = next(arg.removeprefix("query=") for arg in args if arg.startswith("query="))
    tokens = TOKEN.findall(query)
    fields, _ = selection(tokens, tokens.index("{"))
    return {"data": answer(fields)}


def rest(path, args):
    if path.strip("/") == f"repos/{REPO}/pulls/{NUMBER}":
        return {"number": NUMBER, "state": "open", "merged": False, "draft": False,
                "title": "add a widget", "node_id": "PR_stand_in",
                "head": {"ref": BRANCH, "sha": head_sha()}, "base": {"ref": "main"},
                "user": {"login": ACCOUNT}}
    return [] if "--paginate" in args else {}


def reply(args):
    if args[:1] == ["--version"]:
        return "gh version 2.0.0 (stand-in)"
    if args[:2] == ["auth", "status"]:
        return f"Logged in to github.com account {ACCOUNT}"
    if args[:2] == ["auth", "token"]:
        return "stand-in-token"
    if args[:3] == ["api", "user", "--jq"]:
        return ACCOUNT
    if args[:3] == ["api", "user", "--include"]:
        return f'HTTP/2.0 200 OK\nX-Oauth-Scopes: repo, read:org\n\n{{"login": "{ACCOUNT}"}}'
    if args[:2] == ["api", "user"]:
        return json.dumps({"login": ACCOUNT})
    if args[:2] == ["repo", "view"]:
        return json.dumps({"nameWithOwner": REPO})
    if args[:2] == ["repo", "clone"]:
        subprocess.run(["git", "clone", "-q", str(ORIGIN), args[3]], check=True)
        return ""
    if args[:2] == ["search", "prs"]:
        mine = any(arg.startswith("--author") for arg in args)
        return json.dumps([{"number": NUMBER, "repository": {"nameWithOwner": REPO}}] if mine else [])
    if args[:2] == ["api", "graphql"]:
        return json.dumps(graphql(args))
    if args[:1] == ["api"]:
        path = next(arg for arg in args[1:] if arg.startswith(("/", "repos/")))
        return json.dumps(rest(path, args))
    return None


def main():
    args = sys.argv[1:]
    with open(HERE / "calls.log", "a") as calls:
        calls.write(json.dumps(args) + "\n")
    said = reply(args)
    if said is None:
        sys.stderr.write(f"the stand-in GitHub has no answer for gh {' '.join(args)}\n")
        sys.exit(1)
    print(said)


main()
